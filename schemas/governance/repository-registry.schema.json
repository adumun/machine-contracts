{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.adumun.org/governance/repository-registry.schema.json",
  "title": "ADUMUN Repository Governance Registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["registryVersion", "schemaVersion", "status", "repositories"],
  "properties": {
    "registryVersion": {"type": "string"},
    "schemaVersion": {"const": "1.0.0"},
    "status": {"type": "string"},
    "repositories": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["repository", "class", "status", "role"],
        "properties": {
          "repository": {"type": "string", "pattern": "^[^/]+/[^/]+$"},
          "class": {"type": "string"},
          "status": {"type": "string"},
          "role": {"type": "string"},
          "authority": {"type": "string"},
          "newConsumersAllowed": {"type": "boolean"},
          "activeDevelopment": {"type": "boolean"},
          "successors": {"type": "array", "items": {"type": "string"}},
          "standards": {"type": "array", "items": {"type": "string", "pattern": "^RS-[A-Z0-9-]+$"}}
        },
        "additionalProperties": true
      }
    },
    "notes": {"type": "array", "items": {"type": "string"}}
  }
}
