{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://adumun.local/schemas/corporate-operating-intelligence/read-model-metadata.schema.json",
  "title": "ADÜMÜN COI Read-Model Metadata",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version","contract_version","read_model_id","authority_mode","concern_families","generated_at","as_of","freshness_state","reconciliation_state","source_refs","source_health_refs","contract_refs","derivation"],
  "properties": {
    "schema_version": {"const": "coi-read-model-metadata.v1"},
    "contract_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "read_model_id": {"type": "string", "pattern": "^RM-[A-Z0-9][A-Z0-9._-]*$"},
    "authority_mode": {"const": "DERIVED_NON_AUTHORITATIVE"},
    "concern_families": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["FH-CF-01","FH-CF-02","FH-CF-03","FH-CF-04","FH-CF-05"]}},
    "generated_at": {"type": "string", "format": "date-time"},
    "as_of": {"type": ["string","null"], "format": "date-time"},
    "freshness_state": {"enum": ["CURRENT","STALE","UNKNOWN","REVIEW_REQUIRED"]},
    "reconciliation_state": {"enum": ["CURRENT","RECONCILIATION_REQUIRED","UNAVAILABLE"]},
    "source_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "source_health_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "contract_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "derivation": {"$ref": "derivation-metadata.schema.json"}
  }
}
