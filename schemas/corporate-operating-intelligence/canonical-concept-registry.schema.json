{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://adumun.local/schemas/corporate-operating-intelligence/canonical-concept-registry.schema.json",
  "title": "ADÜMÜN COI Canonical Concept Registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version","contract_version","standard_ref","initiative_id","capability_id","concepts"],
  "properties": {
    "schema_version": {"const": "coi-canonical-concept-registry.v1"},
    "contract_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "standard_ref": {"const": "STD-COI-001"},
    "initiative_id": {"const": "INIT-ACC-001"},
    "capability_id": {"const": "CAP-COI-001"},
    "concepts": {"type": "array", "minItems": 1, "items": {"$ref": "canonical-concept.schema.json"}}
  }
}
