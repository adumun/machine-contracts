{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://adumun.local/schemas/corporate-operating-intelligence/source-fact-mapping.schema.json",
  "title": "ADÜMÜN COI Source-to-Fact Mapping",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "contract_version", "initiative_id", "milestone", "mapping_policy", "sources"],
  "properties": {
    "schema_version": {"const": "coi-source-fact-mapping.v1"},
    "contract_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "initiative_id": {"const": "INIT-ACC-001"},
    "milestone": {"const": "S8-M2"},
    "mapping_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["read_only", "semantic_inference", "missing_token_policy", "authority_escalation", "consumer_authority", "row_identity_policy"],
      "properties": {
        "read_only": {"const": true},
        "semantic_inference": {"const": "prohibited"},
        "missing_token_policy": {"const": "explicit"},
        "authority_escalation": {"const": "prohibited"},
        "consumer_authority": {"const": "DERIVED_NON_AUTHORITATIVE"},
        "row_identity_policy": {"const": "source_primary_key_only"},
        "notes": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "sources": {
      "type": "array",
      "minItems": 5,
      "items": {"$ref": "#/$defs/source"}
    }
  },
  "$defs": {
    "mapping": {
      "type": "object",
      "additionalProperties": false,
      "required": ["canonical_concept", "display_label", "semantic_class", "transform", "missing_tokens", "missing_value_state", "missing_limitation"],
      "properties": {
        "canonical_concept": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$"},
        "display_label": {"type": "string", "minLength": 1},
        "match_column": {"type": "string", "minLength": 1},
        "match_value": {"type": "string", "minLength": 1},
        "value_column": {"type": "string", "minLength": 1},
        "interpretation_column": {"type": "string", "minLength": 1},
        "semantic_class": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$"},
        "unit": {"type": "string", "minLength": 1},
        "transform": {"enum": ["COPY_STRING", "PARSE_INTEGER_FORMATTED_NUMBER"]},
        "missing_tokens": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
        "missing_value_state": {"enum": ["UNKNOWN", "MISSING", "RECONCILIATION_REQUIRED", "NOT_APPLICABLE"]},
        "missing_limitation": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$"}
      }
    },
    "row_filter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["column"],
      "properties": {
        "column": {"type": "string", "minLength": 1},
        "equals": {"type": "string", "minLength": 1},
        "in": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      },
      "oneOf": [{"required": ["equals"]}, {"required": ["in"]}]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "concern_family", "provider", "spreadsheet_id", "sheet", "source_title", "authority_mode", "authority_owner", "freshness_registry_ref", "selector_mode", "mappings"],
      "properties": {
        "source_id": {"type": "string", "minLength": 1},
        "concern_family": {"enum": ["FH-CF-01", "FH-CF-02", "FH-CF-03", "FH-CF-04", "FH-CF-05"]},
        "provider": {"const": "GOOGLE_SHEETS"},
        "spreadsheet_id": {"type": "string", "minLength": 10},
        "sheet": {"type": "string", "minLength": 1},
        "source_title": {"type": "string", "minLength": 1},
        "authority_mode": {"enum": ["SOURCE_AUTHORITY", "REGISTRY_AUTHORITY", "DERIVED_NON_AUTHORITATIVE"]},
        "authority_owner": {"type": "string", "minLength": 1},
        "freshness_registry_ref": {"type": "string", "minLength": 1},
        "selector_mode": {"enum": ["LABEL_VALUE", "TABLE_COLUMNS"]},
        "row_identity": {"type": "string", "minLength": 1},
        "row_filter": {"$ref": "#/$defs/row_filter"},
        "row_identity_column": {"type": "string", "minLength": 1},
        "row_identity_required": {"type": "boolean"},
        "label_column": {"type": "string", "minLength": 1},
        "mappings": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/mapping"}}
      },
      "allOf": [
        {
          "if": {"properties": {"selector_mode": {"const": "LABEL_VALUE"}}, "required": ["selector_mode"]},
          "then": {"required": ["row_identity"]}
        },
        {
          "if": {"properties": {"selector_mode": {"const": "TABLE_COLUMNS"}}, "required": ["selector_mode"]},
          "then": {"required": ["row_identity_column", "row_identity_required", "label_column"]}
        }
      ]
    }
  }
}
