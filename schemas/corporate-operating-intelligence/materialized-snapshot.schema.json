{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://adumun.local/schemas/corporate-operating-intelligence/materialized-snapshot.schema.json",
  "title": "ADÜMÜN COI Materialized Snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version","contract_version","read_model_id","name","initiative_id","authority_mode","generated_at","as_of","freshness_state","reconciliation_state","source_status_summary","sources","records","fact_index"],
  "properties": {
    "schema_version": {"const": "coi-materialized-snapshot.v1"},
    "contract_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "read_model_id": {"const": "RM-COI-001"},
    "name": {"const": "Corporate Operating Snapshot"},
    "initiative_id": {"const": "INIT-ACC-001"},
    "authority_mode": {"const": "DERIVED_NON_AUTHORITATIVE"},
    "generated_at": {"type": "string", "format": "date-time"},
    "as_of": {"type": "string", "format": "date-time"},
    "freshness_state": {"enum": ["CURRENT","STALE","UNKNOWN","REVIEW_REQUIRED"]},
    "reconciliation_state": {"enum": ["CURRENT","RECONCILIATION_REQUIRED","UNAVAILABLE"]},
    "source_status_summary": {
      "type": "object", "additionalProperties": false,
      "required": ["total","ok","partial","unavailable"],
      "properties": {
        "total": {"type": "integer", "minimum": 0}, "ok": {"type": "integer", "minimum": 0},
        "partial": {"type": "integer", "minimum": 0}, "unavailable": {"type": "integer", "minimum": 0}
      }
    },
    "sources": {"type": "array", "items": {"$ref": "source-envelope.schema.json"}},
    "records": {"type": "array", "items": {"$ref": "concern-record.schema.json"}},
    "fact_index": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["fact_key","answer_id","record_id","concern_family","object_id","canonical_concept","display_label","value_state","semantic_class","authority","authority_mode","provenance","source_refs","freshness","confidentiality","limitations","drill_through_ref"],
        "properties": {
          "fact_key": {"type": "string", "minLength": 1},
          "answer_id": {"type": "string", "minLength": 1},
          "record_id": {"type": "string", "minLength": 1},
          "concern_family": {"enum": ["FH-CF-01","FH-CF-02","FH-CF-03","FH-CF-04","FH-CF-05"]},
          "object_id": {"type": "string", "minLength": 1},
          "canonical_concept": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$"},
          "display_label": {"type": "string", "minLength": 1},
          "business_meaning": {"type": "string", "minLength": 1},
          "value_state": {"enum": ["KNOWN","UNKNOWN","MISSING","STALE","RECONCILIATION_REQUIRED","RESTRICTED","NOT_APPLICABLE"]},
          "value": {},
          "unit": {"type": ["string","null"]},
          "semantic_class": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$"},
          "authority": {"type": "object", "minProperties": 2},
          "authority_mode": {"type": "string", "minLength": 1},
          "provenance": {"type": "object", "minProperties": 2},
          "source_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "freshness": {"type": "object", "minProperties": 1},
          "confidentiality": {"type": "object", "minProperties": 1},
          "limitations": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "drill_through_ref": {"type": ["string","null"]}
        },
        "allOf": [
          {"if": {"properties": {"value_state": {"const": "KNOWN"}}, "required": ["value_state"]}, "then": {"required": ["value"]}},
          {"if": {"properties": {"value_state": {"enum": ["UNKNOWN","MISSING","RECONCILIATION_REQUIRED","RESTRICTED","NOT_APPLICABLE"]}}, "required": ["value_state"]}, "then": {"not": {"required": ["value"]}}}
        ]
      }
    }
  }
}
